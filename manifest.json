{
    "manifest_version": 3,
    "name": "AEM Links",
    "description": "Base Level Extension",
    "version": "1.0",
    "action": {
      "default_popup": "index.html",
       "default_icon": "assets/icon.png"
    },
    "icons": {
      "128": "assets/icon.png"
    },
    "permissions": ["activeTab"],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
      }
  }